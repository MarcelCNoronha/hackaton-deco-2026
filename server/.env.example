# Bootstrap config only. Per-provider credentials (VTEX, Anthropic, Google refresh tokens)
# are entered through the Connections panel and stored encrypted in the database —
# they do NOT belong in this file.

NODE_ENV=development
PORT=3333

DATABASE_URL=postgresql://catalogia:catalogia@localhost:5433/catalogia
VALKEY_URL=redis://localhost:6379

# 32-byte hex key used to encrypt connection credentials at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# OAuth app registered in Google Cloud Console with Search Console + Analytics (GA4) scopes.
# Per-user refresh tokens obtained via this app are stored encrypted in the `connections` table,
# never here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3333/api/connections/google/callback

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_COOKIE_SECRET=

# Optional — without these, password-reset/invite links are returned directly in the API
# response instead of emailed. Get an API key at resend.com, and verify a sending domain there.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Base URL used to build password-reset/invite links (e.g. https://app.example.com — no trailing
# slash). Optional in dev (falls back to the request's Origin header, then localhost:5173), but
# should always be set in production — trusting Origin there lets a crafted request redirect a
# real reset email's link to an attacker-controlled domain.
APP_BASE_URL=

# Optional — caps how many products an enrichment run processes AT ONCE per task (content,
# alt-text, image generation). Defaults to 5. Lower it if a connected provider has a strict
# requests-per-minute quota; raise it once real throughput against that provider is known.
ENRICHMENT_CONCURRENCY=5
