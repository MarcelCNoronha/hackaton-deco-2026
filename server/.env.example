# Bootstrap config only. Per-provider credentials (VTEX, Anthropic, Google refresh tokens)
# are entered through the Connections panel and stored encrypted in the database —
# they do NOT belong in this file.

NODE_ENV=development
PORT=3333

DATABASE_URL=postgresql://catalogia:catalogia@localhost:5433/catalogia
VALKEY_URL=redis://localhost:6379

# 32-byte hex key used to encrypt connection credentials at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# OAuth app registered in Google Cloud Console with Search Console + Analytics (GA4) scopes.
# Per-user refresh tokens obtained via this app are stored encrypted in the `connections` table,
# never here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3333/api/connections/google/callback

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_COOKIE_SECRET=
