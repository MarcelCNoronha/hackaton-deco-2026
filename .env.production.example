# Template for the GitHub Actions secret `PRODUCTION_ENV_FILE` — its entire content becomes
# the VPS's docker-compose.prod.yml `.env` (used both for compose variable substitution AND
# passed into the app/worker containers via `env_file`). Fill in real values before pasting
# into the GitHub secret; never commit a filled-in version of this file.
#
# IMPORTANT: DATABASE_URL/VALKEY_URL below must use the SAME passwords as DB_PASSWORD/
# VALKEY_PASSWORD — they're not auto-derived, so keep them in sync by hand.

# --- Used by docker-compose.prod.yml itself (image tags, ports) ---
IMAGE_NAME=ghcr.io/OWNER/REPO-server
WEB_IMAGE_NAME=ghcr.io/OWNER/REPO-web
IMAGE_TAG=latest
APP_PORT=80

# --- Postgres (compose substitution) ---
DB_DATABASE=catalogia
DB_USERNAME=catalogia
DB_PASSWORD=CHANGE_ME

# --- Valkey (compose substitution) ---
VALKEY_PASSWORD=CHANGE_ME

# --- App config (passed into the app/worker containers, see server/.env.example) ---
NODE_ENV=production
PORT=3333
DATABASE_URL=postgresql://catalogia:CHANGE_ME@db:5432/catalogia
VALKEY_URL=redis://:CHANGE_ME@valkey:6379
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
GOOGLE_OAUTH_REDIRECT_URI=https://CHANGE_ME.example.com/api/connections/google/callback

# Optional — without these, password-reset/invite links are returned directly in the API
# response instead of emailed. Get an API key at resend.com, and verify a sending domain there.
RESEND_API_KEY=CHANGE_ME
RESEND_FROM_EMAIL=CHANGE_ME
